# ── Backend (read by main.py via python-dotenv) ──────────────────────────────
# Used by the AI Assistant chat endpoint (agents/supplier_agent.py).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Frontend (build-time; Vite only exposes vars prefixed with VITE_) ─────────
# Points the browser at the deployed API. In local dev this defaults to
# http://localhost:8000/api/v1, so you only need to set it on Vercel/Railway.
VITE_API_BASE_URL=/api/v1